STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/white_local?sslmode=disable
DB_NAME=white_local

# AI assistant (openai, ollama or workers-ai)
AI_PROVIDER=none
# Optional fallback provider (openai, ollama or workers-ai)
AI_PROVIDER_FALLBACK=
OPENAI_API_KEY=
# OpenAI-compatible base URL (Groq, Together, OpenRouter, etc.) and model
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional Cloudflare Access service token when OLLAMA_BASE_URL is behind Access
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# Transactional email provider (Resend-compatible REST API)
RESEND_API_KEY=
EMAIL_FROM=

# Optional S3-compatible file storage for product images
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# Catalogue translations (products, categories) — store API applies them
# when the storefront sends ?locale= or x-medusa-locale
MEDUSA_FF_TRANSLATION=true
