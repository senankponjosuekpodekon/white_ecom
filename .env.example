# --- Infra ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/white_local?sslmode=disable
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret
PORT=9000

# --- Cookies (session admin) ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=604800000
SESSION_COOKIE_NAME=connect.sid

# --- CORS ---
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:3000

# --- White-label ---
CLIENT_NAME=default
SITE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=

# --- Paiement manuel (virement / livraison) ---
MANUAL_PAYMENT_ENABLED=true

# --- Emails transactionnels (provider Resend-compatible) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Stockage fichiers S3 (optionnel) ---
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# --- Storefront ---
MEDUSA_BACKEND_URL=http://backend:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOCALES=fr,en
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Traductions catalogue (produits, catégories) dans l'admin Medusa
# Les codes doivent correspondre à NEXT_PUBLIC_LOCALES (ex: fr, en)
MEDUSA_FF_TRANSLATION=true
NEXT_PUBLIC_GA_ID=

# --- IA (optionnel) ---
AI_PROVIDER=none

# --- Phase 4 : provisioning Vercel (control plane backend) ---
# Token Vercel (account/team), repo GitHub du storefront, team optionnelle.
# Quand définis, /admin/clients provisionne un projet Vercel par boutique.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_GIT_REPO=
VERCEL_GIT_REF=main
# URL publique du backend mutualisé (injectée dans les storefronts Vercel)
PLATFORM_BACKEND_URL=

# --- WhatsApp (bouton flottant storefront) ---
WHATSAPP_ENABLED=false
WHATSAPP_NUMBER=
