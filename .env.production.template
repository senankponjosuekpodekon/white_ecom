# Copiez ce fichier en .env.production et remplacez les valeurs.
# ATTENTION : docker-compose n'interpole PAS les ${VAR} à l'intérieur de
# env_file — chaque valeur doit être complète et littérale.

# --- Infra ---
# Nom de domaine public du site (ex: boutique.example.com)
DOMAIN=your-domain.com
# Email utilisé par Let's Encrypt (Traefik ACME)
ACME_EMAIL=your-email@example.com

# --- Base de données ---
DB_NAME=white_main
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

# --- Images Docker (laisser les valeurs par défaut pour utiliser les images locales) ---
BACKEND_IMAGE=white_ecom-backend:latest
STOREFRONT_IMAGE=white_ecom-storefront:latest

# --- Client white-label ---
CLIENT_NAME=default

# --- Medusa ---
# CORS : URL publique du storefront (Traefik route /store, /admin, /auth sur ce domaine)
STORE_CORS=https://your-domain.com
ADMIN_CORS=https://your-domain.com
AUTH_CORS=https://your-domain.com
DATABASE_URL=postgres://postgres:change-me-strong-password@postgres:5432/white_main
REDIS_URL=redis://redis:6379
# Secrets longs et aléatoires obligatoires (ex: openssl rand -base64 48)
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# --- Session / cookies ---
SESSION_COOKIE_NAME=connect.sid
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=604800000

# --- White-label config ---
STORE_NAME=White Shop
PRIMARY_COLOR=#3B82F6
LOGO_URL=
STORE_FONT=Inter
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en
DESIGN_PRESET=modern
SITE_URL=https://your-domain.com

# --- Stripe ---
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Comptes admin (créés au premier démarrage si CREATE_DEFAULT_ADMIN=true) ---
# Mettre CREATE_DEFAULT_ADMIN=false après le premier démarrage.
CREATE_DEFAULT_ADMIN=true
SUPER_ADMIN_EMAIL=super@your-domain.com
SUPER_ADMIN_PASSWORD=change-me-super-admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-admin
MANAGER_EMAIL=manager@your-domain.com
MANAGER_PASSWORD=change-me-manager

# --- Compte client démo ---
DEMO_CUSTOMER_EMAIL=customer@your-domain.com
DEMO_CUSTOMER_PASSWORD=change-me-customer

# --- Storefront ---
MEDUSA_BACKEND_URL=http://backend:9000
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_STRIPE_KEY=pk_live_...
# Paiement manuel (cash à la livraison / test). Mettre false pour le désactiver.
MANUAL_PAYMENT_ENABLED=true
