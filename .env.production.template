# --- Infra ---
DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com

# --- Base de données ---
DB_NAME=white_main
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

# --- Images Docker (laisser les valeurs par défaut pour utiliser les images locales) ---
BACKEND_IMAGE=white_ecom-backend:latest
STOREFRONT_IMAGE=white_ecom-storefront:latest

# --- Client white-label ---
CLIENT_NAME=default

# --- Medusa ---
STORE_CORS=https://${DOMAIN}
ADMIN_CORS=https://${DOMAIN}
AUTH_CORS=https://${DOMAIN}
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# --- Session / cookies ---
SESSION_COOKIE_NAME=connect.sid
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=604800000

# --- White-label config ---
STORE_NAME=White Shop
PRIMARY_COLOR=#3B82F6
LOGO_URL=
STORE_FONT=Inter
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en
DESIGN_PRESET=modern
SITE_URL=https://${DOMAIN}

# --- AI assistant (openai, ollama or workers-ai) ---
AI_PROVIDER=none
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# --- Stripe ---
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Comptes admin (créés au premier démarrage si CREATE_DEFAULT_ADMIN=true) ---
CREATE_DEFAULT_ADMIN=true
SUPER_ADMIN_EMAIL=super@your-domain.com
SUPER_ADMIN_PASSWORD=change-me-super-admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-admin
MANAGER_EMAIL=manager@your-domain.com
MANAGER_PASSWORD=change-me-manager

# --- Compte client démo ---
DEMO_CUSTOMER_EMAIL=customer@your-domain.com
DEMO_CUSTOMER_PASSWORD=change-me-customer

# --- Storefront ---
MEDUSA_BACKEND_URL=http://backend:9000
NEXT_PUBLIC_SITE_URL=https://${DOMAIN}
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://${DOMAIN}
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_STRIPE_KEY=pk_live_...

# --- Free PaaS stack (Vercel + Render + Neon + Upstash) ---
# Backend (Render) env vars to set in Render dashboard:
# PORT=9000
# DATABASE_URL=postgres://<neon-user>:<neon-pass>@<neon-host>/<db>?sslmode=require
# REDIS_URL=rediss://<upstash-token>@<upstash-host>
# STORE_CORS=https://<vercel-preview-or-custom-domain>
# ADMIN_CORS=https://<vercel-preview-or-custom-domain>
# AUTH_CORS=https://<vercel-preview-or-custom-domain>
# SITE_URL=https://<vercel-preview-or-custom-domain>
# JWT_SECRET=<random>
# COOKIE_SECRET=<random>
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Storefront (Vercel) env vars to set in Vercel dashboard:
# NEXT_PUBLIC_SITE_URL=https://<vercel-preview-or-custom-domain>
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://<render-backend-url>
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=<pk from Medusa after first backend boot>
# NEXT_PUBLIC_STRIPE_KEY=pk_live_...
