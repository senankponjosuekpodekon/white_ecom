# Copier en .env.backend pour le développement local (docker compose).
# Secrets Stripe (sk_test_... en dev). Laisser vide pour désactiver Stripe.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Comptes admin créés au premier démarrage (mots de passe par défaut si vide).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=

# "false" desactive le paiement manuel cote serveur (seed + API store)
MANUAL_PAYMENT_ENABLED=true
